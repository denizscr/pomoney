# GEMINI_API_KEY: Required for PRO MONEY AI Financial Assistant server-side calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where PRO MONEY is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC signing secret for session tokens (auto-generated fallback in dev).
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION_32_CHARS_MIN"

# PORT: Server port (3000 required in preview).
PORT="3000"

# ENVIRONMENT: development | testing | staging | production
NODE_ENV="development"

# OPTIONAL POSTGRESQL PRODUCTION CONFIG (when migrating from embedded SQLite to PostgreSQL)
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="pro_money"
PGUSER="pro_money_app"
PGPASSWORD="CHANGE_ME"

# OPTIONAL PHP BRIDGE CONFIGURATION
PROMONEY_DB_DRIVER="sqlite"
PROMONEY_API_URL="http://127.0.0.1:3000"
PROMONEY_WEBHOOK_SECRET="CHANGE_ME_WEBHOOK_HMAC_SECRET"
PROMONEY_BRIDGE_TOKEN="CHANGE_ME_PHP_BRIDGE_TOKEN"

